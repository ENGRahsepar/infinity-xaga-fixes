# ==============================================================================
# FIX 19 (mtk-ims-fixes kit) - MiuiCamera (platform_app_36) and the native
#                                MTK camera services
# ==============================================================================
# The native MTK camera services (aovservice, atms, bgservice, isphal,
# postproc, uievent) are all mapped to `hal_camera_service` in
# device/mediatek/sepolicy_vndr/base/vendor/service_contexts.
#
# A17 moves the platform signed camera app to `platform_app_36`, and the
# neverallow generated by
#   hal_attribute_service(hal_camera, hal_camera_service)
# only exempts `hal_camera_client` / `hal_camera_server`:
#
#   neverallow { domain -hal_camera_client -hal_camera_server ... }
#             hal_camera_service:service_manager find;
#
# So the app could not "find"
#   vendor.mediatek.hardware.camera.isphal.IISPModule/internal/1
# -> the capture pipeline never came up when the camera was opened FROM
# ANOTHER APP (IMAGE_CAPTURE intent) and the picture was never taken.
#
# `hal_camera_client` is a platform private attribute, so this has to
# live in a private (system_ext) sepolicy dir - the same trick the
# platform itself uses for su (system/sepolicy/private/su.te).
# ==============================================================================
typeattribute platform_app_36 hal_camera_client;

allow platform_app_36 hal_camera_service:service_manager find;
