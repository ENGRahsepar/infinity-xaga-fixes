# ---------------------------------------------------------------
# FIX 16/17/18 (mtk-ims-fixes kit) - MiuiCamera on A17
#
# On A17 the platform signed MiuiCamera (com.android.camera) no longer
# runs in `platform_app` but in the NEW domain `platform_app_36`
# (platform key + targetSdk <= 36). Every vendor rule that was written
# for `platform_app` therefore stopped applying to the camera app:
#
#  * /dev/apusys (MTK APU/NPU node) - the MiuiCamera vendor package only
#    grants it to platform_app. Without it the Arcsoft super-night
#    pipeline cannot be initialised and its teardown dereferences a NULL
#    engine:
#        libArcNetMtk.so mcSuperNetMTK_NPURelease
#        -> libarcsoft_super_night_raw.so ARC_SN_PostProcess
#        -> com.xiaomi.plugin.rawsuperlight.so ArcsoftRawSuperlight::uninit
#        -> signal 11, fault addr 0x18, thread CameraSetup
#    (FIX 12 + FIX 13 alone did NOT fix the crash - this is the rule
#     that was missing)
#
#  * proc_stat / app_data_file execute / vendor_camera_data_file - used
#    by the parallel post-processor (ParallelDataZip thread)
#
#  * the MTK ISP/BGS hwservice and the native "isphal" service - needed
#    when the camera is opened FROM ANOTHER APP (IMAGE_CAPTURE intent):
#    the capture pipeline needs vendor.mediatek.hardware.camera.isphal
#    ::IISPModule, otherwise the capture silently does nothing.
#
#  * the property areas the app maps (vendor_default_prop / default_prop)
#
# The rules live here (and not in vendor/xiaomi/miuicamera-xaga) because
# that package only knows about the old `platform_app` domain and is
# synced from upstream, while this device tree is ours.
# ---------------------------------------------------------------

# MTK APU/NPU node used by the super-night (Arcsoft) post-processor
allow platform_app_36 apusys_device:chr_file rw_file_perms;

# parallel post-processor helper
allow platform_app_36 proc_stat:file r_file_perms;
allow platform_app_36 app_data_file:file execute;
allow platform_app_36 vendor_camera_data_file:dir { append map r_dir_perms write };
allow platform_app_36 vendor_camera_data_file:file { getattr open read };

# MTK ISP/BGS HAL + native isphal service (needed for the
# "opened from another app" capture flow)
allow platform_app_36 mtk_hal_bgs_hwservice:hwservice_manager find;
allow platform_app_36 hal_camera_service:service_manager find;

# property areas the app maps for the vendor/default properties
allow platform_app_36 vendor_default_prop:file { getattr open read map };
allow platform_app_36 default_prop:file { getattr open read map };

# camera properties
get_prop(platform_app_36, vendor_mtk_camera_prop);

# The camera HAL reports the DLA model error through a property. The
# generic vendor_default_prop type may not be set by anybody
# (neverallow { domain -init -vendor_init } vendor_default_prop:property_service set)
# so the property gets its own type.
type vendor_camera_dla_prop, property_type, vendor_property_type;
allow mtk_hal_camera vendor_camera_dla_prop:property_service set;
allow mtk_hal_camera vendor_camera_dla_prop:file { getattr open read map };
